# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
# 공공데이터포털(data.go.kr) Decoding 키 하나로 아래 API 들을 활용 신청해서 씁니다:
#  한국관광공사 고캠핑(GoCamping) · 국문/영문/중문/일문 관광정보(TourAPI)
#  기상청 단기예보 · 에어코리아 대기오염정보 · 한국천문연구원 출몰시각(일출·일몰)
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=             # Claude 키 (절대 GitHub에 올리지 말 것)
